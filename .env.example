# Folder the collector writes to (captures/, log.jsonl, STOP). Relative to this file.
FANS_DATA_DIR=../collector
# Shared secret between the web app and the API (the API rejects calls without it). Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN=
# Signs login sessions. Another long random string; changing it signs everyone out.
SESSION_SECRET=
# 1 = session cookie only over HTTPS. Set it when deployed behind HTTPS (it is also on whenever the request is https).
COOKIE_SECURE=

# --- this PC: keep the VPS dashboard up to date (leave empty to not upload) ---
# The VPS dashboard's address (https://), and the SYNC_TOKEN from the VPS's .env (deploy/vps-setup.sh prints both).
VPS_URL=
VPS_SYNC_TOKEN=
# 1 = let the VPS Admin page control the probe on this PC (start, pause, settings, log in to FANS, resume, pull)
VPS_REMOTE_CONTROL=

# --- VPS only (docker-compose.vps.yml) ---
# The domain Caddy serves (and gets the HTTPS certificate for); its DNS must point at the VPS.
DOMAIN=
# The home PC's API proves itself with this when it uploads (the PC's .env has the same value as VPS_SYNC_TOKEN).
SYNC_TOKEN=
# Sign-up and password reset by email, sent through Brevo (app.brevo.com > SMTP & API > API keys). Off while empty.
# MAIL_FROM must be an address on a domain you verified in Brevo, e.g.: AxisMixx <no-reply@axismixx.com>
BREVO_API_KEY=
MAIL_FROM=
# Optional: a Cloudflare Turnstile check on the sign-up form against bots. Off unless both are set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
